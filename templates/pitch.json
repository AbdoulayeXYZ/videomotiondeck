 "voice": {
  "file": "voice/voixoff.mp3",
  "auto_fit": true, "tighten": true, "tail": 0.55, "room": 0.075, "wps": 2.9,
  "lines": [
   {"seg": "hook", "at": 0.8, "text": "Il est quatorze heures à Kaffrine. Quarante et un degrés à l'ombre."},
   {"seg": "choc", "at": 0.3, "text": "Il suffit de deux heures. Deux heures hors du froid, et un vaccin ne protège plus personne."},
   {"seg": "chiffre", "at": 0.3, "text": "Un produit sensible sur quatre se perd avant d'arriver. Sans bruit. Sans preuve."},
   {"seg": "awa", "at": 0.4, "text": "Elle, c'est Awa. Infirmière. Douze villages, une glacière, et aucune preuve que le froid a tenu."},
   {"seg": "question", "at": 0.3, "text": "Alors, sur la route, qui garde le froid quand personne ne regarde ?"},
   {"seg": "brief", "at": 0.4, "text": "Cette question, c'est Partenaire qui nous l'a posée. Défi numéro deux : garantir la chaîne du froid jusqu'au dernier kilomètre."},
   {"reveal": "answer", "text": "Voici notre réponse : Froida."},
   {"seg": "trio", "at": 0.2, "text": "Le froid, mesuré. Le dépôt, alerté. Le patient, protégé."},
   {"seg": "capteur", "at": 0.3, "reveal": 0, "text": "Une sonde au cœur de la glacière."},
   {"reveal": 1, "text": "Une position sur la carte."},
   {"reveal": 2, "text": "Trente jours d'autonomie, même loin de tout."},
   {"reveal": 3, "text": "Et dès que la température dérape, l'alerte part. À la seconde."},
   {"seg": "plateforme", "at": 0.3, "text": "Au dépôt, chaque glacière apparaît en temps réel. La courbe comme preuve. La position comme garantie. Le responsable ne suppose plus : il sait."},
   {"seg": "impact", "at": 0.3, "text": "Trois minutes pour réagir, au lieu d'une journée perdue."},
   {"seg": "valeur", "at": 0.3, "text": "Et pour Partenaire, chaque trajet mesuré devient une décision."},
   {"reveal": 1, "text": "Un écart détecté, c'est un lot sauvé."},
   {"reveal": 3, "text": "Un lot sauvé, c'est une confiance gagnée."},
   {"seg": "reseau", "at": 0.3, "text": "Vos clients, pharmacies, centres de santé, hôpitaux, grossistes, ONG, gagnent la preuve de la qualité. Et vous, leur fidélité."},
   {"seg": "pilote", "at": 0.3, "reveal": 0, "text": "Nous vous proposons un pilote. Sur vos tournées, avec vos équipes."},
   {"reveal": 1, "text": "Vous mesurez. Vous validez."},
   {"reveal": 2, "text": "Puis nous déployons, ensemble, dans tout votre réseau."},
   {"seg": "fin", "at": 0.4, "text": "Alors, sur la route, qui garde le froid ? Désormais, nous."},
   {"reveal": "final", "gain": 1.15, "text": "Merci."}
  ]
 },
